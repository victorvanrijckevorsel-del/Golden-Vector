# Never commit sensitive local financial data (overrides the data/manual negation above)
config/portfolio.local.yaml
data/manual/portfolio/
data/manual/holdings/
data/manual/**/ibkr*.csv
data/manual/**/*portfolio*.csv
*.sqlite3.bak.*

# Local agent/tooling state and scratch files
.claude/
.scratch/
.playwright-mcp/
_pdf_dump.txt
body.txt

# Never commit sensitive local spreadsheets, source docs, research, or scratch screenshots
*.xlsx
*.xlsm
*.xls
*.docx
*.pdf
*.png
CODE_REVIEW.md
SESSION_HANDOFF.md

# Visual redesign curated evidence screenshots (Codex Q1 decision 2026-08-10)
!reviews/codex/milestones/visual_redesign/**/*.png
!reviews/codex/milestones/platform_redesign/*.png
